# CLIMORA AI Environment Variables
PROJECT_NAME="CLIMORA AI"
VERSION="1.0.0"
API_V1_STR="/api/v1"
SECRET_KEY="climora-secret-key-change-in-production-super-secure"
ACCESS_TOKEN_EXPIRE_MINUTES=11520 # 8 days

# Database Configuration (PostgreSQL + PostGIS + TimescaleDB)
DATABASE_URL="postgresql+psycopg2://climora_user:climora_password@localhost:5432/climora_db"

# Redis & Celery
REDIS_URL="redis://localhost:6379/0"
CELERY_BROKER_URL="redis://localhost:6379/1"
CELERY_RESULT_BACKEND="redis://localhost:6379/2"

# Object Storage (MinIO / S3)
MINIO_ENDPOINT="localhost:9000"
MINIO_ACCESS_KEY="minioadmin"
MINIO_SECRET_KEY="minioadmin"
MINIO_BUCKET="climora-datasets"
MINIO_SECURE=false

# Geospatial & Maps
MAPBOX_TOKEN="your_mapbox_public_token_here"
VITE_MAPBOX_TOKEN="your_mapbox_public_token_here"

# CORS
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173"]

# ML Models Directory
ML_MODEL_DIR="backend/app/ml/saved_models"

# Mode
ENVIRONMENT="development"
USE_MOCK_DATA=false
